#!/usr/bin/env bash
# Open first-run setup in a terminal (bar click).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/spaceflight"
FLAG="$STATE/onboard.json"
LOCK="$STATE/launch.lock"
SETUP="$ROOT/scripts/plugin-setup"
mkdir -p "$STATE"
if [[ -f $FLAG ]] && grep -q '"plugin_wizard_done"[[:space:]]*:[[:space:]]*true' "$FLAG"; then
  exit 0
fi
exec 8>"$LOCK"
flock -n 8 || exit 0
if pgrep -u "$(id -u)" -f 'spaceflight plugin-setup' >/dev/null 2>&1; then
  exit 0
fi
export SPACEFLIGHT_SETUP_OWN_TTY=1
if command -v omarchy-launch-tui >/dev/null 2>&1; then
  exec omarchy-launch-tui --app-id=org.omarchy.spaceflight-setup "$SETUP"
fi
if command -v xdg-terminal-exec >/dev/null 2>&1; then
  exec xdg-terminal-exec --app-id=org.omarchy.spaceflight-setup -e "$SETUP"
fi
if command -v ghostty >/dev/null 2>&1; then
  exec ghostty -e "$SETUP"
fi
exit 1
