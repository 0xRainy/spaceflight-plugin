#!/usr/bin/env bash
# Silent CLI/daemon install + shell hook. Never opens a terminal.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/spaceflight"
mkdir -p "$CFG"
cp -f "$ROOT/scripts/shell-hook.bash" "$CFG/shell-hook.bash"
line='[ -r "$HOME/.config/spaceflight/shell-hook.bash" ] && . "$HOME/.config/spaceflight/shell-hook.bash"'
if [[ -f $HOME/.bashrc ]] && ! grep -q 'spaceflight-omarchy-hook' "$HOME/.bashrc"; then
  printf '\n# spaceflight-omarchy-hook\n%s\n' "$line" >>"$HOME/.bashrc"
fi
export PYTHONPATH="${ROOT}${PYTHONPATH:+:$PYTHONPATH}"
python3 -m spaceflight bootstrap >/dev/null || true
"$ROOT/scripts/continue-setup" || true
