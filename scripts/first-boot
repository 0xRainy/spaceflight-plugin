#!/usr/bin/env bash
# Plugin-owned first boot. Does not edit bashrc, PATH, or system files.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/spaceflight"
mkdir -p "$CFG"
cp -f "$ROOT/scripts/teardown" "$CFG/teardown"
chmod +x "$CFG/teardown"
export PYTHONPATH="${ROOT}${PYTHONPATH:+:$PYTHONPATH}"
python3 -m spaceflight bootstrap >/dev/null || true
exec "$ROOT/scripts/ensure-setup"
