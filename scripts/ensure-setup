#!/usr/bin/env bash
# After the plugin is enabled, finish first-run setup.
# Prefer the installer TTY; if that is gone, open one setup terminal.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/spaceflight"
FLAG="$STATE/onboard.json"
LOG="$STATE/setup.log"
mkdir -p "$STATE"

log() { echo "$(date -Iseconds) $*" >>"$LOG"; }

wizard_done() {
  [[ -f $FLAG ]] && grep -q '"plugin_wizard_done"[[:space:]]*:[[:space:]]*true' "$FLAG"
}

setup_running() {
  pgrep -u "$(id -u)" -f 'spaceflight plugin-setup' >/dev/null 2>&1
}

if wizard_done; then
  exit 0
fi

log "ensure-setup: try installer TTY"
"$ROOT/scripts/continue-setup" || true

# Official plugin-add may still be printing "Enabled" — wait briefly.
n=0
while (( n < 10 )); do
  wizard_done && exit 0
  setup_running && exit 0
  sleep 0.2
  n=$((n + 1))
done

if wizard_done || setup_running; then
  exit 0
fi

log "ensure-setup: opening one setup terminal"
exec "$ROOT/scripts/launch-setup"
