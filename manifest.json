{
  "schemaVersion": 1,
  "id": "0xrainy.spaceflight",
  "name": "Spaceflight",
  "version": "1.0.6",
  "author": "0xRainy",
  "license": "MIT",
  "description": "Live rocket launch countdown for the Omarchy Quattro bar — click for mission details, queue, NET, and window. Optional TUI and ntfy phone alerts.",
  "homepage": "https://0xrainy.github.io/spaceflight-plugin/",
  "repository": "https://github.com/0xRainy/spaceflight-plugin",
  "keywords": [
    "launch",
    "rocket",
    "spacex",
    "countdown",
    "bar"
  ],
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Spaceflight",
    "description": "Launch countdown pill; click opens the mission card",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "refreshMs": 1000,
      "displayStyle": "text"
    },
    "schema": [
      {
        "key": "refreshMs",
        "type": "integer",
        "label": "Bar refresh interval (milliseconds)",
        "min": 250,
        "max": 10000,
        "step": 250,
        "defaultValue": 1000
      },
      {
        "key": "displayStyle",
        "type": "string",
        "label": "Bar look: icon (🚀) or text (countdown)",
        "defaultValue": "text"
      }
    ]
  }
}
